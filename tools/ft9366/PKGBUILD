# SPDX-License-Identifier: LGPL-2.1-or-later
# libfprint with the FT9366 driver (template encryption), built from the
# committed state of the ft9366 branch in a local clone at ~/libfprint.
#
#   makepkg -si
#
# After changing the driver: commit, bump pkgrel, run makepkg -si again.

pkgname=libfprint-ft9366
pkgver=1.94.100
pkgrel=1
pkgdesc="libfprint with the unofficial FT9366 (2808:a658) driver and encrypted templates"
arch=(x86_64)
url="https://github.com/Zvegh0809/libfprint-ft9366"
license=(LGPL-2.1-or-later)
depends=(cairo glib2 libgudev libgusb openssl pixman systemd-libs)
makedepends=(git meson gobject-introspection)
provides=("libfprint=$pkgver" libfprint-2.so)
conflicts=(libfprint)
source=("libfprint::git+file://$HOME/libfprint#branch=ft9366")
sha256sums=('SKIP')

build() {
  # FT9366_DEVEL is deliberately not set: release builds cannot dump images
  arch-meson libfprint build \
    -D doc=false \
    -D gtk-examples=false \
    -D installed-tests=false \
    -D drivers=default
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
